# Required for research and drafting (copy to .env and fill in values).
FIRECRAWL_API_KEY=
EXA_API_KEY=
GEMINI_API_KEY=

# App port inside the container (default 8765).
PORT=8765

# Host port published by Docker Compose (default 8765).
HOST_PORT=8765

# Optional: public HTTPS demo (username is always "demo").
# PUBLIC_ORIGIN must be https://your-hostname with no path.
# DEMO_PASSWORD must be at least 16 characters.
# PUBLIC_ORIGIN=https://demo.example.com
# DEMO_PASSWORD=change-me-16-chars-min

# MongoDB storage (optional). When MONGODB_URI is set, runs and research artifacts are
# stored in MongoDB; when unset, they are stored as JSON files only.
# Docker Compose sets this for the web container automatically. For running on your own
# machine against the compose/docker mongo container:
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=personalized_gtm
# MONGO_HOST_PORT=27017

# Team login. With no users yet, the sign-in page shows "Create admin account" (one time).
# Optional: set ADMIN_USERNAME/ADMIN_PASSWORD below to create the first admin at startup instead.
# ADMIN_PASSWORD must be at least 10 characters
# Members are added later in the app (Manage team).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Optional: fixed key for session cookies (32+ chars) and session length in hours (default 12).
# SESSION_SECRET=
# SESSION_HOURS=12

# Sending email from the Outreach tracker (optional). Without SMTP_HOST you can still import,
# research and draft; only the Send button is unavailable. Emails are sent one at a time,
# only after you confirm each draft.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls (port 587), ssl (port 465) or none
# SMTP_USER=you@yourcompany.com
# SMTP_PASSWORD=                # Gmail / Google Workspace: use an app password
# SMTP_FROM=you@yourcompany.com # defaults to SMTP_USER
# SMTP_FROM_NAME=Shubham Kumar  # should match the signature on the drafts
# SMTP_REPLY_TO=
